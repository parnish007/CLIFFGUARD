# Copy to .env and fill in. .env is gitignored and must never be committed.
# Free tiers are enough for the stratified sample; see docs/second_judge.md.

# console.groq.com  -- Llama-3.3-70B, fastest free tier
GROQ_API_KEY=

# build.nvidia.com  -- Llama/Mistral, free credits
NVIDIA_API_KEY=

# aistudio.google.com -- Gemini 2.0 Flash, 1500 req/day free
GEMINI_API_KEY=

# openrouter.ai -- optional, paid but cheap, many families behind one key
OPENROUTER_API_KEY=
